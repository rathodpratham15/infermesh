# InferMesh Test Console configuration (copy to .env). All variables are optional.

# Base URL of the InferMesh gateway.
#  - In `npm run dev` with the default URL, HTTP calls go through the Vite proxy (same origin, no CORS needed).
#  - Anything else (a different URL, or a production build) calls the gateway directly, so the gateway must
#    allow this origin: CORS_ALLOWED_ORIGINS=http://localhost:5173
#  - An EMPTY value means "same origin" (UI and API behind one reverse proxy).
#  - The WebSocket always connects directly, so the gateway also needs WS_ALLOWED_ORIGINS=localhost:5173
VITE_GATEWAY_URL="http://localhost:8080"

# true  = built-in mock gateway with simulated data (works with no server)
# false = talk to the real gateway
VITE_MOCK="true"
